From 2112c1b294d9bfd669214301dca622112c2e9b7c Mon Sep 17 00:00:00 2001
Subject: build: avoid recursive virtual package dependencies

Filter the consumer from virtual providers before selecting defaults or
emitting provider dependencies, and skip dependencies with no provider left.

---
 scripts/package-metadata.pl | 4 +++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/scripts/package-metadata.pl b/scripts/package-metadata.pl
--- a/scripts/package-metadata.pl
+++ b/scripts/package-metadata.pl
@@ -187,0 +188 @@ sub mconf_depends {
+					next if $v->{name} eq $pkgname;
@@ -194,0 +196 @@ sub mconf_depends {
+				next unless @vdeps;
@@ -216 +216,3 @@ sub mconf_depends {
-				$depend = join("||", map { "PACKAGE_".$_->{name} } @$vdep);
+				my @vdeps = grep { $_->{name} ne $pkgname } @$vdep;
+				next unless @vdeps;
+				$depend = join("||", map { "PACKAGE_".$_->{name} } @vdeps);
